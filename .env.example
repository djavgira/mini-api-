# Fill in the required values, then:
#   docker compose up -d --build
#
# Required: POSTGRES_PASSWORD, CONTROL_MASTER_KEY, ADMIN_PASSWORD, GATEWAY_ADMIN_KEY
# Optional: everything else already has a working default.

# --- required ---------------------------------------------------------------

# Database password shared by the gateway and the console analysis service.
# Pick something long and random; it is only used inside the compose network.
POSTGRES_PASSWORD=

# Encrypts the console's stored per-source credentials (>= 32 characters).
# Losing this value means every stored source credential must be re-entered.
CONTROL_MASTER_KEY=

# First console login. Only applied while the console_users table is empty,
# so changing it later requires a password change from inside the console.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# One api key from api.yaml, used by the gateway to authenticate its own
# runtime-fact export and pre-registered as the console's source credential.
# It must be the first key in api_keys, or carry role admin / admin-*.
GATEWAY_ADMIN_KEY=

# --- optional --------------------------------------------------------------

# Published host port for the whole stack (nginx is the only listener).
UNI_API_PORT=8000

ANALYTICS_TIMEZONE=Asia/Shanghai

# Browser-facing origin. Must match the scheme and host the browser uses, or
# the console rejects logins as cross-site requests.
PUBLIC_ORIGIN=http://127.0.0.1:8000

# Set to false once the console is served over HTTPS.
INSECURE_COOKIE=true

# Commit stamped into the image; compose passes it to the build. Leave empty
# for a local build, where it falls back to "unknown".
SOURCE_COMMIT=
